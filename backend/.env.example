# Furnixa backend environment. Copy to backend/.env. Never commit backend/.env or real values.
# Key names follow ADR-011 / ADR-010. Keys marked [ADDED] are not in the original .env; see the end of this file.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# false locally. On Vercel, set 1 because the platform is the proxy. (Hosting is undecided: blockers B-017.)
TRUST_PROXY=false

# MongoDB. Prisma needs a replica set (Atlas, or the docker-compose mongo).
# Replace USER, PASSWORD and CLUSTER, e.g. mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/furnixa_dev?retryWrites=true&w=majority
DATABASE_URL=

# Required once cron routes are mounted. Vercel Cron sends this as x-cron-secret. Which jobs exist: blockers B-021.
# Generate a long random value.
CRON_SECRET=

# Cloudflare R2 (ADR-010). Public base URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# Mail (Nodemailer). Local dev: Mailpit from docker-compose is host localhost, port 1025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. Furnixa <no-reply@yourdomain.com>
MAIL_FROM=

# First admin, read only by the seed script (blockers B-018: `npm run seed` vs `pnpm --filter backend db:seed`).
# Not needed to start the API. The password must be 12 to 128 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Auth (ADR-011)
# Required in production, at least 32 characters each.
# When empty outside production, the API generates a random value at startup,
# so sessions end whenever the backend restarts. Set them to keep sessions.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
CSRF_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Leave empty. Cookies stay host-only on the storefront or admin domain that proxied /api.
AUTH_COOKIE_DOMAIN=
# Empty means true in production and false elsewhere.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Purpose unconfirmed (blockers B-019). Currently unused: OTP expiry is 10 minutes (AUTH-01).
EMAIL_LINK_TTL_SECONDS=3600
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
MAX_ACTIVE_SESSIONS=5

# Web
# Comma-separated browser origins allowed with credentials. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101
STOREFRONT_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101

# Observability. Sentry is disabled while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- [ADDED] keys the docs still need (not in the original .env) ----
# [ADDED] Shared secret sent as x-revalidate-secret to the storefront revalidate route (integrations.md). Must equal web/.env REVALIDATE_SECRET.
REVALIDATE_SECRET=
# [ADDED] Optional. Defaults to ${STOREFRONT_URL}/api/revalidate. Set only if the route lives elsewhere.
WEB_REVALIDATE_URL=
