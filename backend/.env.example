# Furnixa backend environment. Copy to backend/.env. Never commit backend/.env or real values.
# Key names follow ADR-010 / ADR-011 / ADR-012. Keys marked [ADDED] are not in the original .env; see the end of this file.

NODE_ENV=development
PORT=1000
LOG_LEVEL=info
# false locally. 1 in production on Vercel (the platform is the single proxy hop, ADR-012).
TRUST_PROXY=false

# MongoDB Atlas (a replica set, required by Prisma and the Socket.IO adapter). Also used by the native mongodb driver.
# Replace USER, PASSWORD and CLUSTER. On Vercel add pool options (ADR-012):
# mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/furniture_dev?retryWrites=true&w=majority&maxPoolSize=5&minPoolSize=0&maxIdleTimeMS=60000&serverSelectionTimeoutMS=5000
# Databases per environment (infra-deployment.md): furniture_dev / furniture_preview / furniture_prod.
DATABASE_URL=

# Protects /internal/cron/cleanup (ADR-012). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>";
# the route also accepts header x-cron-secret. The route is not mounted when this is empty. Generate a long random value.
CRON_SECRET=

# Cloudflare R2 (ADR-010). All six are required in production (start-up fails otherwise). Public base URL has no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# e.g. https://cdn.example.com
R2_PUBLIC_BASE_URL=

# Mail (Nodemailer). Gmail: host smtp.gmail.com, port 587, user = the Gmail address, pass = an app password (2-step verification on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Gmail SMTP by default; Mailpit optional (offline fallback, docker-compose): SMTP_HOST=localhost, SMTP_PORT=1025, no user/pass.
# Gmail needs the sender to be that account or a verified alias, e.g. Furnixa <you@gmail.com>
MAIL_FROM=

# First admin, read only by the seed script (`npm run seed`).
# Not needed to start the API. The password must be 12 to 128 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Auth (ADR-011)
# Required in production, at least 32 characters each.
# When empty outside production, the API generates a random value at startup,
# so sessions end whenever the backend restarts. Set them to keep sessions.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_PEPPER=
CSRF_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Leave empty. Cookies stay host-only on the storefront or admin domain that proxied /api.
AUTH_COOKIE_DOMAIN=
# Empty means true in production and false elsewhere.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# OTP lifetime in seconds (AUTH-01; replaces EMAIL_LINK_TTL_SECONDS, B-019).
OTP_TTL_SECONDS=600
# Admin-invite code lifetime in seconds (ADM-11, T-017; default 48 h).
INVITE_TTL_SECONDS=172800
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
MAX_ACTIVE_SESSIONS=5

# Web
# Comma-separated browser origins allowed with credentials. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:3101
STOREFRONT_URL=http://localhost:3100
ADMIN_URL=http://localhost:3101

# Observability. Sentry is disabled while SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---- [ADDED] keys the docs still need (not in the original .env) ----
# [ADDED] Shared secret sent as x-revalidate-secret to the storefront revalidate route (integrations.md). Must equal web/.env REVALIDATE_SECRET.
REVALIDATE_SECRET=
# [ADDED] Optional. Defaults to ${STOREFRONT_URL}/api/revalidate. Set only if the route lives elsewhere.
WEB_REVALIDATE_URL=
# [ADDED] Socket.IO adapter collection (ADR-012). TTL collection; documents older than the TTL are removed.
SOCKET_ADAPTER_COLLECTION=socket.io-adapter-events
# [ADDED] TTL for adapter documents, also used by the cron cleanup.
SOCKET_ADAPTER_TTL_SECONDS=3600
# [ADDED] Seed only (`npm run seed`). true = also create 12 sample products (no images). Refused when NODE_ENV=production. Never needed for the API.
SEED_DEMO_DATA=false

# `npm run demo:reset -- --confirm` (local dev only: NODE_ENV=development and a furniture_dev / furniture_preview database).
# Password for the 12 demo customers; at least 12 characters. Leave empty here, set it in your own .env.
DEMO_CUSTOMER_PASSWORD=
# [ADDED] Seed only. Public contact email/phone for the SiteSetting created by `npm run seed`. Optional: when empty the seed uses
# placeholder@example.com / +966500000000 and logs a warning. Change them from the admin dashboard before launch. Never needed for the API.
SEED_CONTACT_EMAIL=
SEED_CONTACT_PHONE=
