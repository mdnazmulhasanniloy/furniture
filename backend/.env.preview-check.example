# Env for scripts/preview-check.ts (T-026). Copy to backend/.env.preview-check (git-ignored).
# Credentials come only from this file, never from CLI arguments, and are never printed.

# Base URL of the deployment to check, e.g. https://furnixa-api-abc123.vercel.app (no trailing slash).
PREVIEW_URL=

# A verified account on the preview database (steps 2-3). Must be an ADMIN for --long (step 5).
PREVIEW_EMAIL=
PREVIEW_PASSWORD=

# Optional. Same value as the Vercel project env CRON_SECRET. Empty = step 4 is skipped.
CRON_SECRET=

# Optional. Vercel -> Project -> Settings -> Deployment Protection -> "Protection Bypass for Automation"
# -> generate a secret. Sent as x-vercel-protection-bypass on HTTP requests and in the socket handshake.
VERCEL_PROTECTION_BYPASS=

# --long only (step 5): a verified CUSTOMER on the preview database. The customer places and holds an
# order; the admin (PREVIEW_EMAIL) confirms it while the socket is disconnected. Needs at least one
# published product with stock on the preview DB (seed with SEED_DEMO_DATA=true - preview only).
PREVIEW_CUSTOMER_EMAIL=
PREVIEW_CUSTOMER_PASSWORD=
