{
  "name": "furnixa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "build:vercel": "node scripts/vercel-typecheck.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx scripts/demo-data/reset-and-seed.ts",
    "p95": "tsx scripts/p95-check.ts",
    "migrate:refresh-family": "tsx scripts/migrations/2026-11-21-refresh-token-family.ts",
    "postinstall": "prisma generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1173.0",
    "@aws-sdk/s3-request-presigner": "3.1173.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "11.16.0",
    "@socket.io/mongo-adapter": "0.4.0",
    "@socket.io/mongo-emitter": "0.2.0",
    "@vercel/functions": "3.11.3",
    "argon2": "0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "7.9.1",
    "nodemailer": "^10.6.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sanitize-html": "2.17.0",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.20.0",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.5.0",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
