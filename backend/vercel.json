{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/socket-io.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!api/socket-io).*)", "destination": "/api/index?__originalPath=/$1" }
  ],
  "crons": [{ "path": "/internal/cron/cleanup", "schedule": "0 3 * * *" }]
}
