# Public base path for client API calls; same-origin thanks to the /api/* rewrite (ADR-011)
NEXT_PUBLIC_API_URL=/api/v1
# Backend origin the /api/:path* rewrite proxies to (server-only, ADR-011)
API_ORIGIN=http://localhost:1000
# Socket.IO server origin; the socket is NOT proxied — the client connects to the backend
# origin directly with path /api/socket-io, addTrailingSlash: false, websocket only (ADR-012)
NEXT_PUBLIC_SOCKET_URL=http://localhost:1000
# Public storefront URL (metadata, sitemap, e2e base)
STOREFRONT_URL=http://localhost:3100
# Cloudflare R2 public base URL (ADR-010); its host is allowed in images.remotePatterns.
# Required when NODE_ENV=production — the build fails without it.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
REVALIDATE_SECRET=change-me-revalidate
# Dev only: extra hosts allowed to load the `next dev` server (comma separated, host without port). Without this a dev
# server opened from another machine or an IP never hydrates (Next blocks cross-origin dev resources). Restart dev after changing.
ALLOWED_DEV_ORIGINS=
